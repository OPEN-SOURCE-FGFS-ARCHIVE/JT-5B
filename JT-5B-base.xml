<?xml version="1.0" encoding="UTF-8"?>

<PropertyList>

  <sim include="JT-5B_views.xml">
  
    <fuel-fraction>0.8</fuel-fraction>
        
  
    <startup>
      <splash-texture>Aircraft/JT-5B/splash.png</splash-texture>
    </startup>

    <sound>
      <path>Aircraft/JT-5B/Sounds/JT-5B-sound.xml</path>
    </sound>

 <systems>
   <electrical>
    <path>Aircraft/Generic/generic-electrical.xml</path>
	</electrical>
   </systems> 
    
    <model>
      <path>Aircraft/JT-5B/Models/JT-5B.xml</path>
      <livery>
        <file type="string">default</file>
      </livery>
      <JT-5B>
        <rotor-step-deg type="float">-1.0</rotor-step-deg>
      </JT-5B>
    </model>

	<rendering>
<refl_correction type="string">-0.51</refl_correction>
<frensel-factor type="string">0.5</frensel-factor>
</rendering>


    <multiplay>
      <chat_display>1</chat_display>
      <generic>            	    
        <int n="0" alias="/controls/switches/nav-lights-switch" />                      
        <int n="1" alias="/controls/switches/beacon-switch" />                     
        <int n="2" alias="/controls/switches/landing-lights-switch" />                         
        <int n="3" alias="/controls/switches/strobe-switch" />                                     
        <int n="4" alias="/controls/smoke" />                                     
        <int type="int" n="5">  0 </int>                                     
        <int type="bool" n="6"> 1 </int>                                     
        <int n="7" alias="/sim/crashed" />                                  
        <int n="8" alias="/systems/electrical/outputs/nav-lights">  0 </int>  <!-- 8 nav-lights -->
        <int n="9" alias="/sim/model/lights/beacon/state">  false </int>      <!-- 9 strobe-lights -->
        <int n="10" alias="/controls/electric/key-pos">  0 </int>             <!-- 10 key position -->
        <float n="0" alias="/sim/model/door-positions/crew/position-norm"/>
        <float n="1" alias="/sim/model/door-positions/passenger/position-norm"/>
        <float n="2" alias="/position/gear-agl-m"> 0 </float>                         <!-- altitude for MP shadow -->
        <float n="3" alias="/position/altitude-ft"> 0 </float>                        <!-- altitude for Smoke/Trail -->
        <float n="4" alias="/engines/engine[0]/rpm"/>
        <float n="5" alias="/engines/engine[0]/cranking"/>
        <float n="6" alias="/gear/gear[0]/wow/"/>
        <float n="7" alias="/gear/gear[1]/wow/"/>
        <float n="8" alias="/gear/gear[2]/wow/"/>
        <float n="9" alias="/gear/gear[0]/rollspeed-ms"/>
        <float n="10" alias="/gear/gear[1]/rollspeed-ms"/>
        <float n="11" alias="/gear/gear[2]/rollspeed-ms"/>
        <float n="12" alias="/velocities/airspeed-kt"/>
        <float n="13" alias="/controls/flight/aileron"/>
        <float n="14" alias="/gear/gear[0]/compression-norm"/>
        <float n="15" alias="/gear/gear[1]/compression-norm"/>
        <float n="16" alias="/gear/gear[2]/caster-angle-deg"/>
        <!-- For Bombable -->
        <int type="int" n="10" alias="controls/armament/trigger">0</int>
        <string n="9" type="string" />
      </generic>
    </multiplay>

	<flight-recorder>
    <replay-config type="int">0</replay-config>
			<config n="0" include="/Aircraft/Generic/flightrecorder/generic-piston-propeller-1.xml">
			<name type="string">My Aircraft's Flight Recorder</name>

 <signal>
          <type>float</type> <!-- Canopy Position -->
          <property type="string">/sim/model/door-positions/crew/position-norm</property>
        </signal>
        <signal>
          <type>float</type> <!-- Slider Position -->
          <property type="string">/sim/model/door-positions/passenger/position-norm</property>
        </signal>
                     
	<signal>
          <type>float</type>
          <property type="string">/environment/relative-humidity</property>
        </signal>
        <signal>
          <type>float</type>
          <property type="string">/environment/temperature-degc</property>
        </signal>
       <signal>
          <type>float</type>
          <property type="string">/velocities/airspeed-kt</property>
        </signal>
          <signal>
          <type>float</type>
          <property type="string">/sim/multiplay/generic/int[4]</property>
        </signal>

        <signal>
          <type>float</type>
          <property type="string">/sim/multiplay/generic/float[14]</property>
        </signal>

        <signal>
          <type>float</type>
          <property type="string">/sim/multiplay/generic/float[15]</property>
        </signal>

         <signal>
          <type>float</type>
          <property type="string">/sim/multiplay/generic/float[16]</property>
        </signal>

       <signal>
          <type>float</type>
          <property type="string">/sim/model/surface-positions/rudder-pos-norm</property>
        </signal>

       				<signal>
				    <type>int</type>
				    <property type="string">/rotors/main/rpm</property>
				</signal>
				
				<signal>
					<type>double</type>
					<property type="string">/rotors/main/tilt/roll-deg</property>
				</signal>
				
				<signal>
					<type>double</type>
					<property type="string">/rotors/main/tilt/pitch-deg</property>
				</signal>
			</config>	
	</flight-recorder>  

<view n="0">
    <internal archive="y">true</internal>
    <config>
      <x-offset-m archive="y">0.000</x-offset-m> <!-- Right -->
      <y-offset-m archive="y">0.525</y-offset-m> <!-- Up    -->
      <z-offset-m archive="y">-0.585</z-offset-m> <!-- Back  -->
      <pitch-offset-deg>-14.00</pitch-offset-deg>
      <default-field-of-view-deg>116</default-field-of-view-deg>
    </config>
  </view>
	
    <help>
			<key>
                <name>s</name>
                <desc>Start Engine</desc>
            </key>
			<key>
                <name>B</name>
                <desc>Toggle parking brake</desc>
            </key>
			<key>
                <name>r</name>
                <desc>Apply rotor brake</desc>
            </key>
			<key>
                <name>k</name>
                <desc>Toggle Look Up</desc>
            </key>
			<key>
                <name>l</name>
                <desc>Toggle Look Down</desc>
            </key>
			
      <title>JT-5B (Autogyro)</title>
      <line>   Start And Take Off</line>
      <line>1:Start engine (S-Key)</line>
      <line>2:Prerotate rotor to 250 rpm (hold S-Key)</line>
      <line>3:Release parking-brake ('B'-key)</line>
      <line>4:Add power to accelerate and pull the stick back 1/3</line>
      <line>5:Wait to accelerate then add full power</line>
      <line>6:Wait for the rotor to reach sufficient rpm (~350)</line>
      <line>7:Use the stick to slowly pull up and fly</line>
      <line></line>
      <line>   Landing</line>
      <line>1:Reduce power to 1/4</line>
      <line>2:Wait to slow down. Don't force forward pitch.</line>
      <line>3:When you slow down to 40-50 pitch down and hold ~50kt</line>
      <line>4:Over the runway round off then reduce power and pitch up a little</line>
      <line>5:Touch down and wait rotor to slow down somewhat.</line>
      <line>6:Pull the stick full back to use rotor to slow down.</line>
      <line></line>
      <line>   Good to know</line>
      <line>The rotor accelerates faster the more you pull the stick</line>
      <line>This aircraft doesn't stall, but the rotor can slow down.</line>
      <line>The rotor rpm should be kept over 450...</line>
      <line>Max rotor rpm 600 or 3-G. Max speed 90kts.</line>
      <line></line>
      <line>   Warning!</line>
      <line>Avoid sudden movements. This can cause Pilot Induced Oscillation (PIO).</line>
	  <line>Never force forward pitch. This can cause negative G.</line>
	  <line>Use throttle first, stick later.</line>
	  <line>Avoid flying at zero G! It is dangerous!</line>
	  <line>Negative and zero G can cause a Power Pushover (PPO).</line>
	  </help>

    <hud>
      <path n="1">Aircraft/JT-5B/JT-5B_hud.xml</path>
            <visibility n="1">false</visibility>
            <enable3d n="1">false</enable3d>
			
    </hud>


		<weight n="0">
			<name>Internal_Front</name>
			<weight-lb>0</weight-lb>
			<max-lb>100</max-lb>
		</weight>

		<weight n="1">
			<name>Internal_LeftGear</name>
			<weight-lb>0</weight-lb>
			<max-lb>100</max-lb>
		</weight>

		<weight n="2">
			<name>Internal_RightGear</name>
			<weight-lb>0</weight-lb>
			<max-lb>100</max-lb>
		</weight>

		
  <menubar>
        <default>
            <menu n="10">
                <label>JT-5B Autogyro</label>
                <enabled type="bool">true</enabled>
                <item>
                    <label>Select Livery</label>
                    <binding>
                        <command>nasal</command>
                        <script>aircraft.livery.dialog.toggle()</script>
                    </binding>
                </item>
		
		
            </menu>
        </default>
    </menubar>

   <!-- Payload  -->
   <weight>
   <name type="string">Pilot</name>
   <weight-lb alias="/yasim/jt5b/pilot-lb"/>
   <min-lb type="double">0.0</min-lb>
   <max-lb type="double">210.0</max-lb>
  </weight> 
  

  </sim>

  <yasim>
    <jt5b>
	  <pilot-lb>180.0</pilot-lb>
    </jt5b>
  </yasim>


  <input>
    <keyboard include="JT-5B-keyboard.xml"/>
  </input>

  
  <controls>
  
    <engines>
      <engine n="0">
        <magnetos>3</magnetos>
      </engine>
    </engines>
    
    <gear>
      <brake-parking>1</brake-parking>
    </gear>
    <lighting>
      <strobe type="bool">true</strobe>
      <beacon type="bool">true</beacon>
      <nav-lights type="bool">true</nav-lights>
    </lighting>
    
    <rotor>
      <reltarget>1</reltarget>
      <maxreltorque>1</maxreltorque>
    </rotor>
    <canopy>
      <canopy-pos-norm type="float">1.0</canopy-pos-norm>
   </canopy>

   <smoke alias="/sim/multiplay/generic/int[4]"/>
       
  </controls>

  
  <rotors>
    <main>
      <rpm type="double">0</rpm>
    </main>
  </rotors>

    <engines>
		<engine>
		<rpm type="double">0</rpm>
		</engine>
   </engines>
  
    <systems>
            <electrical>
                <outputs>
    <instrument-lights-norm type="int">20
	</instrument-lights-norm>
				</outputs>
            </electrical>
        </systems>
	<nasal>
		 
	<JT-5B>
		<file>Aircraft/JT-5B/Nasal/Liveries.nas</file>
	
	</JT-5B>
	
	<gyro>
		<file>Aircraft/JT-5B/Nasal/gyro.nas</file>
	</gyro>
	
	<heli>
		<file>Aircraft/JT-5B/Nasal/heli.nas</file>
	</heli>

    <lights>
      <file>Aircraft/JT-5B/Nasal/Lights.nas</file>
   </lights>

    <doors>
      <file>Aircraft/JT-5B/Nasal/doors.nas</file>
    </doors>
	
	</nasal>

</PropertyList>

