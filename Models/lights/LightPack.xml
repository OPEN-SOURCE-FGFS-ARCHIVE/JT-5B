<?xml version="1.0" encoding="UTF-8"?>

<PropertyList>

  <!-- nav lights -->
  <!-- green and red navigation lights, usually mounted on the wingtips -->
  <!-- note: default orientation is up -->
  <model>
    <name>GreenLight</name>
    <path>Aircraft/JT-5B/Models/Lights/GreenLight.xml</path>
    <offsets>
       <x-m>1.149</x-m>
      <y-m>0.779</y-m>
      <z-m>0.023</z-m>
      <roll-deg>-90</roll-deg>
      <pitch-deg>-5</pitch-deg> <!-- due to roll, this tunes heading - I want it to point 5 deg more forward -->
    </offsets>
  </model>
  <model>
    <name>RedLight</name>
    <path>Aircraft/JT-5B/Models/Lights/RedLight.xml</path>
    <offsets>
      <x-m>1.149</x-m>
      <y-m>-0.779</y-m>
      <z-m>0.023</z-m>
      <roll-deg>90</roll-deg>
      <pitch-deg>-5</pitch-deg> <!-- due to roll, this tunes heading - I want it to point 5 deg more forward -->
    </offsets>
  </model>
  
  <!-- beacon -->
  <!-- bright red flashing light -->
  <!-- note: default orientation is up -->
  <model>
    <name>Beacon1</name>
    <path>Aircraft/JT-5B/Models/Lights/Beacon.xml</path>
    <offsets>
      <x-m>0.992</x-m>
      <y-m> 0.000 </y-m> 
       <z-m>0.356</z-m> 
      <pitch-deg>-180</pitch-deg>
    </offsets>
  </model> 

