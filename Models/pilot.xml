<?xml version="1.0"?>

<PropertyList>

  <path>general_pilot.ac</path>

  <animation>
    <!-- Objets opaques -->
    <object-name>tete</object-name>
    <object-name>visiere</object-name>
    <object-name>corps</object-name>
    <object-name>brasG</object-name>
    <object-name>brasD</object-name>
    <object-name>avantbrasG</object-name>
    <object-name>avantbrasD</object-name>
    <object-name>manche</object-name>
    <object-name>cuisseG</object-name>
    <object-name>cuisseD</object-name>
    <object-name>jambeG</object-name>
    <object-name>jambeD</object-name>
    <object-name>piedG.001</object-name>
    <object-name>piedD.001</object-name>

    <!-- Objets transparents -->
  </animation>

  <animation>
    <name>AnimeTete</name>
    <object-name>tete</object-name>
    <object-name>visiere</object-name>
  </animation>

<animation>
  <type>rotate</type>
  <object-name>PilotHead</object-name>
  <object-name>PilotVisor</object-name>
  <property>surface-positions/rudder-pos-norm</property>
  <factor>-40</factor>
  <center>
   <x-m>-0.178</x-m>
   <y-m>0</y-m>
   <z-m>0.321</z-m>
  </center>

  <axis>
   <x>0.000000</x>
   <y>0.000000</y>
   <z>1.000000</z>
  </axis>
 </animation>

<animation>
  <type>rotate</type>
  <object-name>PilotHead</object-name>
  <object-name>PilotVisor</object-name>
  <property>sim/multiplay/generic/float[13]</property>
  <factor>-18</factor>
  <center>
   <x-m>-0.178</x-m>
   <y-m>0</y-m>
   <z-m>0.321</z-m>
  </center>

  <axis>
   <x>1.000000</x>
   <y>0.000000</y>
   <z>0.000000</z>
  </axis>
 </animation>

<animation>
  <type>rotate</type>
  <object-name>PilotHead</object-name>
  <object-name>PilotVisor</object-name>
  <property>controls/flight/elevator</property>
  <factor>-30</factor>
  <center>
   <x-m>-0.178</x-m>
   <y-m>0</y-m>
   <z-m>0.321</z-m>
  </center>

  <axis>
   <x>0.000000</x>
   <y>1.000000</y>
   <z>0.000000</z>
  </axis>
 </animation>

<!-- *** LoD *** -->
  <animation> 
    <type>range</type>
    <min-m>1</min-m>
    <max-m>10000</max-m>
  </animation>

</PropertyList>
